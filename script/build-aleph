#!/usr/bin/env bash

# Build and install Aleph Dev as a macOS .app bundle.
#
# Usage:
#   script/build-aleph          # build + install to /Applications
#   script/build-aleph --build  # build only (no bundle/install)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CRATE_DIR="$ROOT_DIR/crates/aleph"
CARGO_TOML="$CRATE_DIR/Cargo.toml"

export PATH="/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH"

# Safety check: RELEASE_CHANNEL must be "dev" for Aleph Dev builds.
# If this is "stable", the app will use the macOS system keychain instead of
# the file-based credential store, causing password prompts on every new build.
# This file gets accidentally reset to "stable" during upstream Zed merges.
RELEASE_CHANNEL=$(cat "$CRATE_DIR/RELEASE_CHANNEL" | tr -d '\n')
if [ "$RELEASE_CHANNEL" != "dev" ]; then
    echo "ERROR: crates/aleph/RELEASE_CHANNEL is '$RELEASE_CHANNEL' but must be 'dev'"
    echo "       This was likely reset during an upstream merge. Fix it:"
    echo "       echo 'dev' > crates/aleph/RELEASE_CHANNEL"
    exit 1
fi

BUILD_ONLY=false
if [[ "${1:-}" == "--build" ]]; then
    BUILD_ONLY=true
fi

# Zed's custom cargo-bundle fork is required (adds --select-workspace-root)
cargo_bundle_version=$(cargo -q bundle --help 2>&1 | head -n 1 || echo "")
if [ "$cargo_bundle_version" != "cargo-bundle v0.6.1-zed" ]; then
    echo "==> Installing cargo-bundle (Zed fork)..."
    cargo install cargo-bundle --git https://github.com/zed-industries/cargo-bundle.git --branch zed-deploy
fi

echo "==> Building aleph (release)..."
cargo build --release -p aleph

if $BUILD_ONLY; then
    echo "==> Build complete: target/release/aleph"
    exit 0
fi

echo "==> Bundling Aleph Dev.app..."

# cargo-bundle requires [package.metadata.bundle] but we store it as
# [package.metadata.bundle-dev]. Temporarily rename it for bundling.
cp "$CARGO_TOML" "$CARGO_TOML.backup"
sed -i '' 's/package.metadata.bundle-dev/package.metadata.bundle/' "$CARGO_TOML"

cleanup() {
    mv "$CARGO_TOML.backup" "$CARGO_TOML"
}
trap cleanup EXIT

cd "$CRATE_DIR"
CARGO_BUNDLE_SKIP_BUILD=true cargo bundle --release --select-workspace-root
cd "$ROOT_DIR"

APP_PATH="$ROOT_DIR/target/release/bundle/osx/Aleph Dev.app"

echo "==> Installing to /Applications..."
rm -rf "/Applications/Aleph Dev.app"
cp -r "$APP_PATH" /Applications/

echo "==> Done! Aleph Dev.app installed to /Applications."
